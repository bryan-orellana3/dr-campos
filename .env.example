# URL de la landing de venta. Todos los CTA del resultado apuntan aquí.
# Mientras no esté definida, los botones quedan deshabilitados con un aviso visible.
VITE_CTA_URL=

# Webhook opcional para recibir los leads (GoHighLevel, Zapier, Make…).
# Recibe un POST con Content-Type: application/json y este cuerpo:
#   name, email, country, countryName, dial, phone, phoneE164,
#   score, resultId, resultStage, resultTitle,
#   answers, plataformas, plataformaOtra, quiz, completedAt,
#   utm_source, utm_medium, utm_campaign, utm_content, utm_term, fbclid, gclid
# Si falla o no está definido, el diagnóstico se muestra igual y el lead
# queda guardado en localStorage bajo la clave `dc-quiz-lead-pendiente`.
VITE_LEAD_WEBHOOK=
